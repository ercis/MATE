    "build": "node scripts/bundle-modules.mjs && next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-typescript http://localhost:8000/openapi.json -o lib/api-types.ts",
    "bundle-modules": "node scripts/bundle-modules.mjs",
    "watch-modules": "node scripts/bundle-modules.mjs --watch"
  },
