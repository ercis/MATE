{
  "name": "@mate/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,mods -c blue,magenta \"next dev --turbo --port 3000\" \"node scripts/bundle-modules.mjs --watch\"",
