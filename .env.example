# Copy to `.env` and rotate the secrets before exposing the stack to anyone
# besides yourself.

# ── Web origin the browser uses to reach the API. Inlined at build time. ──
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Demo login bypass (LOCAL/DEV ONLY) ──────────────────────────────────────
# true → the login page auto-signs you in as a fixed, non-admin "Demo User"
# with no Keycloak, and the API accepts the demo sentinel token. Set the SAME
# flag in apps/web/.env.local. NEVER enable in a shared/public deployment.
DEMO_MODE=false
# true → the demo user gets the "admin" role (admin pages + /admin/* API).
# Only has effect when DEMO_MODE is on. Set the SAME flag in apps/web/.env.local.
DEMO_ADMIN=false

# ── Behaviour tracking (api) ────────────────────────────────────────────────
# USER_TRACKING_ONBOARDING controls the usage-tracking default & policy:
#   force – tracking is ON for every user; the onboarding privacy step and the
#           Settings → Privacy tab are hidden and users cannot opt out.
#   on    – tracking is enabled by default during onboarding (user can opt out).
#   off   – tracking is disabled by default during onboarding (user can opt in).
USER_TRACKING_ONBOARDING=force

# ── Storage backend (api) ──────────────────────────────────────────────────
# Where event logs + module outputs are durably stored. This is the ONLY place
# the backend is configured – there is no admin UI. `local` (default) keeps a
# single copy under data/. `s3` makes an S3-compatible bucket (AWS S3, Ceph
# RGW, MinIO, Backblaze, R2, …) the authoritative store and turns local disk
# into a bounded working cache, so the VM volume stops growing with
# total-data-ever. After switching, copy existing data with
# `uv run python -m mate.api.storage.migration to_s3` and verify the
# connection with `… migration check`. Full reference: docs/S3_OFFLOAD.md.
STORAGE_MODE=local
# Endpoint URL incl. scheme (https://rgw.example.org, http://minio:9000).
# Leave EMPTY for AWS S3 proper – boto3 derives the regional endpoint; every
# other provider needs it set.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
# Required by AWS (endpoint + SigV4 scope). Most self-hosted providers ignore
# it; Cloudflare R2 wants `auto`.
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Path-style addressing (host/bucket/key): required by Ceph RGW / MinIO
# without wildcard DNS. Set false on AWS (virtual-host style).
STORAGE_S3_PATH_STYLE=true
STORAGE_S3_USE_SSL=true
# TLS verification: empty = system CAs, `false` = disable, or a path to a CA
# bundle (on-prem endpoints with an internal CA).
STORAGE_S3_VERIFY=
# Key prefix inside the bucket – lets several deployments share one bucket.
STORAGE_S3_PREFIX=
# Total-bucket ceiling in bytes; imports are rejected (HTTP 507) once usage
# reaches it. 0 = no quota.
STORAGE_S3_QUOTA_BYTES=0
# S3-mode local-cache reaper: keep the working cache under this many bytes by
# evicting least-recently-used log/output dirs (they survive in the bucket and
# re-hydrate on the next read). 0 = never evict. Dry-run logs candidates
# without deleting – soak first, then set false to actually reclaim disk.
LOCAL_CACHE_MAX_BYTES=0
CACHE_EVICT_DRY_RUN=true
CACHE_EVICT_MIN_AGE_SECONDS=600
# Prune terminal jobs older than N days (bounds metadata.db). 0 = keep all.
JOB_RETENTION_DAYS=0

# ── MCP server (api) ────────────────────────────────────────────────────────
# Model Context Protocol endpoint at /mcp for external AI clients (Claude,
# Codex, …). Default OFF – enabling it opens a network surface. See DEPLOY.md
# → "MCP server" for the full setup (Keycloak client, Caddy routes, consent).
MCP_ENABLED=false
# Public base URL of the API (e.g. https://pm-mate.uni-muenster.de). Required
# for OAuth discovery (RFC 9728) and the advertised endpoint URL.
API_BASE_URL=
# Pre-registered Keycloak public client for MCP OAuth (empty = PAT-only).
# Create it with infra/keycloak/configure-mcp-client.sh.
MCP_OAUTH_CLIENT_ID=
# true → only read tools are registered; writes are refused server-wide.
MCP_READ_ONLY=false
# Csv of enabled toolsets (meta,processes,analysis,dashboards,jobs,watched,
# account,admin). Empty = all except admin; "all" also enables admin.
MCP_TOOLSETS=
# Require the per-user egress opt-in (Settings → API & MCP) before any tool
# returns data. Keep on outside local dev.
MCP_REQUIRE_EGRESS_CONSENT=true

# ── Auth.js (web) ─────────────────────────────────────────────────────────
# Generate a fresh 32+ byte secret with `openssl rand -base64 32`.
AUTH_SECRET=dev-only-change-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# ── Keycloak ───────────────────────────────────────────────────────────────
# `iss` claim on issued tokens – must match what the API validates.
KEYCLOAK_ISSUER=http://localhost:8080/realms/flows-funds
# Confidential web client; the secret lives only on the Next.js server.
KEYCLOAK_CLIENT_ID=flows-funds-web
KEYCLOAK_CLIENT_SECRET=flows-funds-web-dev-secret
# Brokered IdP alias to jump straight to (kc_idp_hint) – skips Keycloak's login
# page. Must match the alias in the registered broker redirect URI
# (.../broker/keycloak-oidc/endpoint). Leave empty to show Keycloak's local
# login form (break-glass for admin@flows-funds.local).
KEYCLOAK_IDP_HINT=
# Audience the API expects on the access token.
KEYCLOAK_AUDIENCE=flows-funds-api
# JWKS endpoint the API uses to fetch signing keys (docker DNS name).
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/flows-funds/protocol/openid-connect/certs
# Admin REST client for the "delete user" flow (also removes the Keycloak
# account). Create it with infra/keycloak/configure-admin-client.sh; leave the
# secret empty to make the delete's Keycloak step a no-op (Mate data is still
# purged). Base URL is the internal docker DNS name (add /auth in prod).
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=flows-funds
KEYCLOAK_ADMIN_CLIENT_ID=flows-funds-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── Keycloak Postgres ──────────────────────────────────────────────────────
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
