# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
.turbo/
out/
# TypeScript incremental build state - regenerated by every `tsc` run, and
# already excluded from the Docker build context by .dockerignore.
*.tsbuildinfo

# Exporter logs
.cc-history/

# Editor/agent tool caches
.impeccable/

# Modules are tracked in git (source + manifest). Only the per-folder build
# artefacts and large/vendored payloads below are ignored.
modules/*/.venv/
modules/*/.dist/
modules/*/node_modules/
modules/*/.installed-hash

# The JVM example module's runnable fat jar is a COMMITTED artefact - the api
# image is JRE-only and modules/ is bind-mounted, so the platform can't build
# it; `make sdk-jvm` regenerates it. Carve it out of the global `dist/` ignore.
!modules/performance_java/dist/
!modules/performance_java/dist/*.jar

# CV4CDD pretrained models are large (~0.5 GB each) and uploaded at runtime via
# the module's settings page – never committed. The dir itself is kept via a
# .gitkeep; the per-folder rules live in modules/cv4cdd/model/.gitignore.

# Runtime data (the directory layout itself is kept via .gitkeep)
data/event_logs/*
!data/event_logs/.gitkeep
data/module_results/*
!data/module_results/.gitkeep
data/users/
data/staging/
data/uploaded_modules/
data/module-uploads/
data/uv-python/
data/.multi_user_migrated
data/metadata.db
data/metadata.db-wal
data/metadata.db-shm
data/*.bak
# `Settings.data_dir` defaults to the *relative* path `data`, so launching the
# API from anywhere but the repo root drops a second runtime tree next to the
# cwd. Only the root `data/` is real - catch the common stray.
apps/api/data/

# Local environment overrides (Auth.js + Keycloak secrets land here)
.env
.env.local
apps/web/.env.local

# Generated TypeScript types
packages/shared-types/generated/
tasks.md

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# ── Carried over from the public repo's .gitignore ──────────────────────
# These protect a PUBLIC repo. `apps/api/data/` especially: the root-anchored
# `data/...` rules never covered it, and it holds the live SQLite metadata DB.
modules/node_modules
modules/*/cv4cdd/
scripts/deploy.env
