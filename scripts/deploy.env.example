# Copy to scripts/deploy.env (gitignored) and fill in the real values, which
# live in the team's internal deployment notes. Sourced by scripts/deploy.sh.

DEPLOY_HOST=<vm-hostname>   # the deploy VM - reachable only on the dev VPN
DEPLOY_PORT=<ssh-port>
DEPLOY_USER=<ssh-login>

# Optional overrides (defaults shown):
# DEPLOY_DIR=~/mate
# DEPLOY_BRANCH=<current branch>
# DEPLOY_PUBLIC_URL=https://pm-mate.uni-muenster.de
