# Mate – on-VM reverse proxy (production).
#
# The uni edge proxy forwards pm-mate.uni-muenster.de:80/443 to this VM's :443
# as a single HTTPS pipe. This Caddy instance terminates that TLS with the
# provided Let's Encrypt cert and fans the one origin out to the three
# app containers by path. See DEPLOY.md for the full picture.

{
	# We ship our own cert and sit behind the uni proxy – no ACME.
	auto_https off
}

# Bind by port (not hostname): the VM cert's name differs from the public name
# (pm-mate), and we're behind another proxy, so match any SNI/Host.
#
# TLS_CERT_DIR is the on-VM Let's Encrypt live dir for this host, passed in by
# docker-compose.prod.yml from .env - it is deliberately not hardcoded here.
:443 {
	tls {$TLS_CERT_DIR}/fullchain.pem {$TLS_CERT_DIR}/privkey.pem

	# FastAPI backend – REST under /api/v1, plus WebSocket (live jobs/events)
	# and SSE (Mate AI streaming). Caddy proxies both transparently.
	@api path /api/v1/*
	reverse_proxy @api api:8000

	# Unauthenticated liveness probe (root-level /health on the API).
	@health path /health
	reverse_proxy @health api:8000

	# Keycloak, served under the /auth relative path (KC_HTTP_RELATIVE_PATH).
	@kc path /auth/*
	reverse_proxy @kc keycloak:8080

	# Force revalidation of the Next.js HTML/RSC documents and the Auth.js
	# session route (/api/auth/*) so a fresh visit never renders a stale app
	# shell carrying an expired token – the "first load 401s, hard-refresh
	# fixes it" symptom. Scoped to EXCLUDE the api/health/keycloak upstreams
	# (incl. SSE under /api/v1/*) and the hashed, immutable build assets under
	# /_next/static + /_next/image, which must stay cacheable.
	@webDoc {
		not path /api/v1/* /health /auth/* /_next/static/* /_next/image*
	}
	header @webDoc Cache-Control "no-store"

	# Everything else – the Next.js app, its static assets, and Auth.js
	# routes at /api/auth/*.
	reverse_proxy web:3000
}
